[package]
name = "smaa"
version = "0.21.0"
description = "A library for post process antialiasing using SMAA"
repository = "https://codeberg.org/fintelia/smaa-rs"
keywords = ["graphics", "antialiasing", "SMAA"]
categories = ["rendering", "game-engines"]
license = "MIT"
edition = "2021"
include = ["README.md", "LICENSE", "/src", "/third_party"]

[dependencies]
wgpu = { default-features = false, version = "30", features = ["glsl"] }

[dev-dependencies]
winit = "0.29"
futures = "0.3.30"
